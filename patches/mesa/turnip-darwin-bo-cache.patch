+   pthread_mutex_lock(&dw_stats_lock);
+   unsigned i = 0;
+   for (; i < ARRAY_SIZE(dw_name_stats) - 1; i++)
+      if (!dw_name_stats[i].name || !strcmp(dw_name_stats[i].name, name))

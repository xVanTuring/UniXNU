+   if (!dw_name_stats[i].name)
+      dw_name_stats[i].name = i == ARRAY_SIZE(dw_name_stats) - 1 ? "other" : name;
+   dw_name_stats[i].count++;
+   dw_name_stats[i].bytes += bytes;
+   dw_name_stats[i].ns += took;

+/* pipa BO cache: releases a cached BO to the kernel (an eviction), under retire->lock. */
+static VkResult
+darwin_release_cached(struct tu_device *dev, struct darwin_retire_state *retire, const struct darwin_cached_bo *c)
+{
+   const uint64_t unmap_began = os_time_get_nano();
+   kern_return_t kr = IOConnectUnmapMemory64(dw.conn, c->token, mach_task_self(), (mach_vm_address_t)(uintptr_t)c->mapping);
+   dw_note_method(21, unmap_began);
+   if (kr != KERN_SUCCESS)
+      return retire->failure = vk_device_set_lost(&dev->vk, "cached BO CPU unmap failed: 0x%x", kr);
+   NativeAdrenoAbiBoCpuUnmap undo = {.handle = c->handle, .token = c->token};
+   kr = dw_call(NativeAdrenoMethodBoCpuUnmap, &undo, sizeof(undo), NULL, 0);
+   if (kr != KERN_SUCCESS)
+      return retire->failure = vk_device_set_lost(&dev->vk, "cached BO CPU lease release failed: 0x%x", kr);
+   NativeAdrenoAbiBoFree release = {.handle = c->handle};
+   kr = dw_call(NativeAdrenoMethodBoFree, &release, sizeof(release), NULL, 0);
+   if (kr != KERN_SUCCESS)
+      return retire->failure = vk_device_set_lost(&dev->vk, "cached BoFree failed: 0x%x", kr);
+   darwin_free_iova(dev, c->iova, c->size);
+   return VK_SUCCESS;
+}

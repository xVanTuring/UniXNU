+/* pipa BO cache: keeps a retired BO whose fence completed, evicting the oldest ones past the cache's bounds. False leaves it to the
+ * ordinary release (too large, or an eviction failed). Under retire->lock. */
+static bool
+darwin_cache_keep(struct tu_device *dev, struct darwin_retire_state *retire, const struct darwin_retired_bo *bo)
+{
+   if (bo->size > DARWIN_CACHE_LARGEST)
+      return false;
+   while (retire->cached_count && (retire->cached_count == DARWIN_CACHED_BOS ||
+                                   retire->cached_bytes + bo->size > DARWIN_CACHE_BYTES)) {
+      struct darwin_cached_bo oldest = retire->cached[0];
+      memmove(&retire->cached[0], &retire->cached[1], (retire->cached_count - 1) * sizeof(retire->cached[0]));
+      --retire->cached_count;
+      retire->cached_bytes -= oldest.size;
+      ++retire->cache_evictions;
+      if (darwin_release_cached(dev, retire, &oldest) != VK_SUCCESS) {
+         darwin_cache_publish(retire);
+         return false;
+      }
+   }
+   retire->cached[retire->cached_count++] = {bo->handle, bo->iova, bo->size, bo->mapping, bo->token, bo->read_only};
+   retire->cached_bytes += bo->size;
+   darwin_cache_publish(retire);
+   return true;
+}
+
+/* pipa BO cache: the newest cached BO of exactly `size` bytes and the permission asked for, taken out of the cache; false if none. */
+static bool
+darwin_cache_take(struct darwin_retire_state *retire, uint64_t size, bool read_only, struct darwin_cached_bo *out)
+{
+   pthread_mutex_lock(&retire->lock);
+   for (unsigned i = retire->cached_count; i-- > 0;) {
+      if (retire->cached[i].size != size || retire->cached[i].read_only != read_only)
+         continue;
+      *out = retire->cached[i];
+      memmove(&retire->cached[i], &retire->cached[i + 1], (retire->cached_count - 1 - i) * sizeof(retire->cached[0]));
+      --retire->cached_count;
+      retire->cached_bytes -= size;
+      ++retire->cache_hits;
+      darwin_cache_publish(retire);
+      pthread_mutex_unlock(&retire->lock);
+      return true;
+   }
+   ++retire->cache_misses;
+   darwin_cache_publish(retire);
+   pthread_mutex_unlock(&retire->lock);
+   return false;
+}

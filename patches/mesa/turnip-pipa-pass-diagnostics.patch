+/* pipa: the last distinct render passes as text, for the plugin's kernel-log telemetry (NativeBridgeMetalFrontend.mm reads it with
+ * dlsym). Turnip has no log route of its own in the render server on this device, and the corner question of 2026-10-24 (4-row slices
+ * of a GMEM pass ending up in the wrong place) needs the pass's own numbers: area, format, samples, mode, bin geometry, store path.
+ * Diagnostic only; nothing here changes a result. */
+static char tu_pipa_notes[32][120];
+static unsigned tu_pipa_note_count;
+static pthread_mutex_t tu_pipa_notes_lock = PTHREAD_MUTEX_INITIALIZER;
+
+__attribute__((visibility("default"))) void tu_pipa_note(const char *text)
+{
+   pthread_mutex_lock(&tu_pipa_notes_lock);
+   for (unsigned i = 0; i < tu_pipa_note_count; i++)
+      if (!strcmp(tu_pipa_notes[i], text))
+         goto out;
+   if (tu_pipa_note_count < ARRAY_SIZE(tu_pipa_notes)) {
+      snprintf(tu_pipa_notes[tu_pipa_note_count], sizeof tu_pipa_notes[0], "%s", text);
+      tu_pipa_note_count++;
+   }
+out:
+   pthread_mutex_unlock(&tu_pipa_notes_lock);
+}
+
+bool
+tu_pipa_notes_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      enabled = debug && strstr(debug, "pipa_notes") ? 1 : 0;
+   }
+   return enabled;
+}

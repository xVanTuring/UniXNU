+      for (unsigned slot = 0; slot < PIPA_TS_SLOTS; slot++) {
+         const uint64_t begin = times[slot * 2], end = times[slot * 2 + 1];
+         if (!begin || !end)
+            continue;
+         if (end > begin) {
+            struct pipa_ts_shape *shape = &pipa_ts_shapes[pipa_ts_shape_of[slot]];
+            shape->count++;
+            shape->ticks += end - begin;
+            if (end - begin > shape->longest)
+               shape->longest = end - begin;
+         }
+         times[slot * 2] = times[slot * 2 + 1] = 0;
+      }
+      /* The shapes by their GPU time, most first: count, total and mean (19.2 MHz ticks as ms and us) and the longest. */
+      bool shown[PIPA_TS_SHAPES] = {};
+      for (unsigned row = 0; row < 8; row++) {
+         int best = -1;
+         for (unsigned i = 0; i < PIPA_TS_SHAPES; i++)
+            if (!shown[i] && pipa_ts_shapes[i].count && (best < 0 || pipa_ts_shapes[i].ticks > pipa_ts_shapes[best].ticks))
+               best = (int) i;
+         if (best < 0)
+            break;
+         shown[best] = true;
+         const struct pipa_ts_shape *shape = &pipa_ts_shapes[best];
+         int n = snprintf(out + at, size - at, "PT %ux%u %s n%llu %llums mean %lluus max %lluus %.24s\n", shape->width, shape->height,
+                          best == PIPA_TS_SHAPES - 1 ? "other" : shape->sysmem ? "sys" : "gmem", (unsigned long long) shape->count,
+                          (unsigned long long) (shape->ticks / 19200), (unsigned long long) (shape->ticks * 10 / 192 / shape->count),
+                          (unsigned long long) (shape->longest * 10 / 192),
+                          shape->sysmem && shape->reason ? shape->reason : "");
+         if (n <= 0 || (unsigned) n >= size - at)
+            break;
+         at += (unsigned) n;
+      }
+   }
+   pthread_mutex_unlock(&pipa_ts_lock);
+   return at;
+}
+
+__attribute__((visibility("default"))) unsigned tu_pipa_note_dump(char *out, unsigned size)
+{
+   unsigned at = 0;
+   pthread_mutex_lock(&tu_pipa_notes_lock);
+   for (unsigned i = 0; i < tu_pipa_note_count && at + 2 < size; i++) {
+      int n = snprintf(out + at, size - at, "%s\n", tu_pipa_notes[i]);
+      if (n > 0)
+         at += (unsigned)n;
+   }
+   pthread_mutex_unlock(&tu_pipa_notes_lock);
+   out[at < size ? at : size - 1] = 0;
+   return at;
+}
+
+/* pipa: a render area at most this many pixels large goes to sysmem (0 = off), read from TU_DEBUG's "pipa_small-<pixels>" token (the boot argument grammar allows no second "="). A
+ * diagnostic switch for the rounded corners of 2026-10-24: the small offscreen pass whose GMEM store is the unaligned 2D path
+ * (64 x 34 in the render server) is the one suspect left that no Turnip debug option reaches. */
+__attribute__((visibility("default"))) unsigned tu_pipa_small_threshold(void)
+{
+   static long value = -1;
+   if (value < 0) {
+      value = 0;
+      const char *debug = os_get_option("TU_DEBUG");
+      const char *at = debug ? strstr(debug, "pipa_small-") : NULL;
+      if (at)
+         value = strtol(at + strlen("pipa_small-"), NULL, 10);
+   }
+   return (unsigned) value;
+}
+
+/* pipa: every image created or imported linear (no tiling, no UBWC), from TU_DEBUG's "pipa_linear" token. Diagnostic: the rounded
+ * corners of 2026-10-24 come out in 4 x 4 pixel blocks in GMEM passes only, and a linear render target tells a layout problem from a
+ * coverage one. */
+__attribute__((visibility("default"))) bool tu_pipa_linear(void)
+{
+   static int value = -1;
+   if (value < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      value = debug && strstr(debug, "pipa_linear") ? 1 : 0;
+   }
+   return value != 0;
+}
+
+/* pipa: render passes that carry input attachments (framebuffer fetch) stay in system memory. In GMEM that read goes through
+ * tu_emit_input_attachments' patched descriptor, and on this board the partially transparent pixels come back in 4 x 4 blocks
+ * (2026-10-25: the rounded corners of the UI, the only edges with alpha, were chamfered; the same pass in system memory is smooth and
+ * its submit-to-retire mean halves, 11.8 ms against 6.7 ms).
+ * TU_DEBUG's "pipa_gmemin" puts such passes back into GMEM for whoever finds the descriptor's fault. 2026-10-25 evening: the four A650
+ * fixes backported that day (uninitialised gmem_offset, tile divisor levels, GRAS_MODE_CNTL, TPL1_DBG_ECO_CNTL) are in and GMEM was
+ * made the default to try them; the corners were still chamfered, so those four are not this bug and the detour is the default again.
+ * Later the same day the patched descriptor was compared field by field with the gmem descriptor of the 3D blit (tu_clear_blit.cc,
+ * r3d_src_gmem), which reads gmem tiles correctly: format, swap, pitch (tile0.width * cpp), tile mode, depth and the cleared ubwc flag
+ * all agree - except TILE_ALL, which that path clears and this one inherited from the image's view. Reading the image's own
+ * descriptor instead ("pipa_iaplain") gives correct corners and every-draw UCHE invalidation ("pipa_iaflush") changes nothing, so the
+ * fetched data is not stale: the tile was being read with the tiled (block interleaved) addressing. tu_emit_input_attachments() now
+ * clears TILE_ALL like the blit does, and "pipa_gmemin" is the switch that puts such passes back into GMEM to check it. */
+__attribute__((visibility("default"))) bool tu_pipa_gmem_input_attachments(void)
+{
+   static int value = -1;
+   if (value < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      value = debug && strstr(debug, "pipa_gmemin") ? 1 : 0;
+   }
+   return value != 0;
+}
+
+/* pipa: TU_DEBUG's "pipa_iaplain" makes tu_emit_input_attachments fall back to the image's own (system memory) descriptor even in a
+ * GMEM pass. Diagnostic. With it the corners are correct row by row (2026-10-25), which proves the fault is on the read side and that
+ * the fault is in what the gmem descriptor makes the hardware read, not in the gmem store.
+ * It is a diagnostic only because it is not safe as a default: it reads the RAM copy, and the driver patches these descriptors
+ * precisely when the RAM copy is stale - see tu_render_pass_patch_input_gmem(): the attachment was cleared in gmem, or written by an
+ * earlier subpass or draw of this pass. A pass that writes and then reads the same attachment would silently read pre-pass content,
+ * which looks smooth and wrong. Passes that read before they write are unaffected, which is why this app renders correctly with it. */
+__attribute__((visibility("default"))) bool tu_pipa_ia_plain(void)
+{
+   static int value = -1;
+   if (value < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      value = debug && strstr(debug, "pipa_iaplain") ? 1 : 0;
+   }
+   return value != 0;
+}
+
+/* pipa: TU_DEBUG's "pipa_iaflush" invalidates UCHE before every draw whose subpass reads a GMEM attachment. It was written for the
+ * theory that the 4 x 4 blocks are stale 64-byte cache lines (a cache line of a cpp 4 attachment is one 4 x 4 pixel block of the
+ * tiled layout); tried on 2026-10-25 it changed nothing at all, so the fetched data is not stale - the address the hardware computes
+ * is wrong, see the TILE_ALL clear in tu_emit_input_attachments(). Kept because it is the cheapest way to re-check that theory if a
+ * future symptom does turn out to be a stale line. */
+__attribute__((visibility("default"))) bool tu_pipa_ia_flush(void)
+{
+   static int value = -1;
+   if (value < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      value = debug && strstr(debug, "pipa_iaflush") ? 1 : 0;
+   }
+   return value != 0;
+}
+
+/* pipa: TU_DEBUG's "pipa_uchegmem" lets Turnip program the UCHE gmem window itself (tu_cmd_buffer.cc, tu6_init_static_regs), which
+ * the kernel normally does and this port does not. Part of the same refuted stale-line theory as tu_pipa_ia_flush(): with
+ * "pipa_iaflush" showing no effect, a missing UCHE window would not explain the blocks either, so this one is only for the record. */
+__attribute__((visibility("default"))) bool tu_pipa_uche_gmem(void)
+{
+   static int value = -1;
+   if (value < 0) {
+      const char *debug = os_get_option("TU_DEBUG");
+      value = debug && strstr(debug, "pipa_uchegmem") ? 1 : 0;
+   }
+   return value != 0;
+}

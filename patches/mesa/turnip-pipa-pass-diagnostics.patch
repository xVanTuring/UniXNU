+/* pipa: the GPU time of each render pass instance (tu_cmd_render: CP_ALWAYS_ON_COUNTER, 19.2 MHz, before the pass and after a WFI at its
+ * end) in a ring of slots, summed by the pass's area and mode at each dump: which passes hold the GPU while an app opens (2026-10-25:
+ * 20 ms of GPU a frame for about 15 passes and 20 megapixels). Diagnostic only. */
+#define PIPA_TS_SLOTS 16384
+#define PIPA_TS_SHAPES 24
+struct pipa_ts_shape {
+   uint32_t width, height;
+   bool sysmem;
+   uint64_t count, ticks, longest;
+   const char *reason;   /* why the last such pass went to system memory (gmem_disable_reason) */
+};
+static struct tu_bo *pipa_ts_bo;
+static struct tu_device *pipa_ts_device;
+static uint8_t pipa_ts_shape_of[PIPA_TS_SLOTS];
+static struct pipa_ts_shape pipa_ts_shapes[PIPA_TS_SHAPES];
+static unsigned pipa_ts_shape_count;
+static uint32_t pipa_ts_next;
+static pthread_mutex_t pipa_ts_lock = PTHREAD_MUTEX_INITIALIZER;
+
+uint64_t
+tu_pipa_pass_slot(struct tu_device *dev, uint32_t width, uint32_t height, bool sysmem, const char *reason)
+{
+   pthread_mutex_lock(&pipa_ts_lock);
+   if (!pipa_ts_bo && !pipa_ts_device) {
+      pipa_ts_device = dev;
+      if (tu_bo_init_new(dev, NULL, &pipa_ts_bo, PIPA_TS_SLOTS * 16, TU_BO_ALLOC_NO_FLAGS, "pipa pass times") != VK_SUCCESS) {
+         pipa_ts_bo = NULL;
+      } else if (tu_bo_map(dev, pipa_ts_bo, NULL) != VK_SUCCESS) {
+         tu_bo_finish(dev, pipa_ts_bo);
+         pipa_ts_bo = NULL;
+      } else {
+         memset(pipa_ts_bo->map, 0, PIPA_TS_SLOTS * 16);
+      }
+   }
+   if (!pipa_ts_bo || dev != pipa_ts_device) {
+      pthread_mutex_unlock(&pipa_ts_lock);
+      return 0;
+   }
+   unsigned shape = 0;
+   for (; shape < pipa_ts_shape_count; shape++)
+      if (pipa_ts_shapes[shape].width == width && pipa_ts_shapes[shape].height == height && pipa_ts_shapes[shape].sysmem == sysmem)
+         break;
+   if (shape == pipa_ts_shape_count) {
+      if (pipa_ts_shape_count < PIPA_TS_SHAPES - 1) {
+         pipa_ts_shapes[shape] = (struct pipa_ts_shape) {width, height, sysmem, 0, 0, 0, NULL};
+         pipa_ts_shape_count++;
+      } else {
+         shape = PIPA_TS_SHAPES - 1;   /* the rest together */
+      }
+   }
+   if (sysmem)
+      pipa_ts_shapes[shape].reason = reason;
+   const uint32_t slot = pipa_ts_next++ % PIPA_TS_SLOTS;
+   uint64_t *times = (uint64_t *) pipa_ts_bo->map + slot * 2;
+   times[0] = times[1] = 0;
+   pipa_ts_shape_of[slot] = (uint8_t) shape;
+   pthread_mutex_unlock(&pipa_ts_lock);
+   return pipa_ts_bo->iova + slot * 16;
+}

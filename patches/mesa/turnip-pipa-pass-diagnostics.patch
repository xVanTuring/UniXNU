+/* pipa: true when this subpass reads at least one attachment that is written in GMEM, i.e. when tu_emit_input_attachments patches a
+ * descriptor to point into gmem. Diagnostic only. */
+static bool
+tu_pipa_subpass_reads_gmem(struct tu_cmd_buffer *cmd)
+{
+   const struct tu_subpass *subpass = cmd->state.subpass;
+
+   if (!subpass || !cmd->state.pass || !cmd->state.tiling ||
+       !cmd->state.tiling->possible)
+      return false;
+
+   for (unsigned i = 0; i < subpass->input_count; i++) {
+      const uint32_t a = subpass->input_attachments[i].attachment;
+
+      if (a != VK_ATTACHMENT_UNUSED &&
+          subpass->input_attachments[i].patch_input_gmem &&
+          cmd->state.pass->attachments[a].gmem)
+         return true;
+   }
+
+   return false;
+}

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index a688021..44697a5 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1928,7 +1928,10 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	size_t l1_entries = 1 + ((bytes_mapped + ARM_TT_L1_SIZE - 1) / ARM_TT_L1_SIZE);
 	/* 1 L1 each for V=P and KVA, plus 1 page for each L2 */
 	size_t pages_used = 2 * (l1_entries + 1);
-	if (pages_used > BOOTSTRAP_TABLE_SIZE) {
+	/* pages_used is a page count and BOOTSTRAP_TABLE_SIZE a byte count: the
+	 * old comparison was never true and could not have caught start.s
+	 * stopping in place (2026-10-24, a 7.75 GiB window). */
+	if (pages_used > BOOTSTRAP_TABLE_SIZE / ARM_PGBYTES) {
 		panic("BOOTSTRAP_TABLE_SIZE too small for memory config");
 	}
 #endif

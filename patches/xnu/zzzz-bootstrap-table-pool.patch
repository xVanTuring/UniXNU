diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
index 3f59f6b..03a8ac1 100644
--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -116,10 +116,13 @@
  */
 #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 34)
 #elif !defined(APPLE_ARM64_ARCH_FAMILY) && !__ARM_16K_PG__
-/* Native 4 KiB: two roots plus up to seven L2 pages per 6 GiB mapping.
- * The physical and virtual bases may each straddle an extra 1 GiB region.
+/* Native 4 KiB: two roots plus one L2 page per GiB of each mapping. The pool is
+ * sized for 16 GiB of DRAM (2 * 16 L2 + 2 roots); the old 16-page pool held 14
+ * L2 pages, which the 5.75 GiB window already used 12 of and which a 7.75 GiB
+ * window overran by two on 2026-10-24 (osfmk/arm64/start.s stops in place when
+ * the pool runs out, before any log exists: see HANDOFF-pipa-memory.md).
  */
-#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 16)
+#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 34)
 #else /* defined(ARM_LARGE_MEMORY) */
 #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 8)
 #endif /* defined(ARM_LARGE_MEMORY) */
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index a688021..44697a5 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1928,7 +1928,10 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	size_t l1_entries = 1 + ((bytes_mapped + ARM_TT_L1_SIZE - 1) / ARM_TT_L1_SIZE);
 	/* 1 L1 each for V=P and KVA, plus 1 page for each L2 */
 	size_t pages_used = 2 * (l1_entries + 1);
-	if (pages_used > BOOTSTRAP_TABLE_SIZE) {
+	/* pages_used is a page count and BOOTSTRAP_TABLE_SIZE a byte count: the
+	 * old comparison was never true and could not have caught start.s
+	 * stopping in place (2026-10-24, a 7.75 GiB window). */
+	if (pages_used > BOOTSTRAP_TABLE_SIZE / ARM_PGBYTES) {
 		panic("BOOTSTRAP_TABLE_SIZE too small for memory config");
 	}
 #endif
